PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/email-marketing-tool
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-generate-a-long-random-secret
SMTP_CREDENTIALS_KEY=generate-a-base64-encoded-32-byte-key
SMTP_CREDENTIALS_PREVIOUS_KEY=
SMTP_ALLOWED_HOSTS=smtp.gmail.com,smtp.office365.com
IMAP_ALLOWED_HOSTS=imap.gmail.com,outlook.office365.com
# Optional one-time migration; only the account matching SMTP_USER and SMTP_FROM can import it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional live integration test URI; use a dedicated database ending in "test".
MONGODB_TEST_URI=
